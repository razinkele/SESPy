# Deploy target for deploy/deploy.sh.
# Copy this file to deploy/config.env (which is gitignored) and set your values.
#
#   cp deploy/config.env.example deploy/config.env
#   # then edit deploy/config.env
#
# DEPLOY_SERVER — SSH destination with passwordless (key-based) access.
# DEPLOY_DIR    — the Shiny Server app directory on that host.

DEPLOY_SERVER=user@host
DEPLOY_DIR=/srv/shiny-server/SESPy
